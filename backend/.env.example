# ============================================
# Smart Study - Backend Environment Configuration
# ============================================

# Database connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartstudy?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email SMTP Configuration (Optional - Gracefully skipped if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Smart Study" <noreply@smartstudy.platform>
